# Hotel Concierge Agent Environment Variables

# LLM Provider API Keys (Optional - System will use local models/fallback if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM Provider Selection ("auto", "gemini", "openai", "ollama", "local")
LLM_PROVIDER=auto
